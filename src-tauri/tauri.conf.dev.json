{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splitkick",
  "identifier": "app.splitkick.desktop.dev",
  "build": {
    "beforeDevCommand": "bun run scripts/tauri-dev-before.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Splitkick (Dev)",
        "width": 800,
        "height": 600,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/azeitler/splitkick/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMTM2MkMzMTJDQUFENzAKUldSd3Jjb1N3MklUMHh0amw2Q3F0QmhzUmFQVzV2OXhoQXV0S3pmb2RpTjJmdW9uYlUzN1oxYVIK"
    }
  }
}
